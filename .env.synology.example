# Copy this file to .env in the Synology project directory.
# Do not commit the real .env file.

LABDB_SYNOLOGY_ROOT=/volume1/docker/flare-eln
LABDB_WEB_PORT=8000

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=nas-name.local,192.168.1.10,labdb.example.org

LABDB_PROD_DB_NAME=labdb
LABDB_PROD_DB_USER=labdb_user
LABDB_PROD_DB_PASSWORD=replace-with-a-strong-database-password

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
