# Copy this file to .env in the Synology project directory.

LABDB_SYNOLOGY_ROOT=/volume1/docker/flare-eln
LABDB_WEB_PORT=8000

# For compose.synology.images.yml only: use an actual published release tag.
# The automatic updater replaces this with the exact image digest after success.
# FLARE_IMAGE=ghcr.io/fedeceri85/flare-eln:v1.2.0

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=nas-name.local,192.168.1.10,labdb.example.org

# When HTTPS terminates at a reverse proxy, list the exact browser origins,
# including https:// and any nonstandard port. Leave empty for plain HTTP.
# Example: https://marcotti-nas:8000
DJANGO_CSRF_TRUSTED_ORIGINS=

LABDB_PROD_DB_NAME=labdb
LABDB_PROD_DB_USER=labdb_user
LABDB_PROD_DB_PASSWORD=replace-with-a-strong-database-password

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
