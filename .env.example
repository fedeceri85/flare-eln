# Copy this file to .env for local Docker testing.

LABDB_STACK_DB_NAME=lab_container_stack
LABDB_STACK_DB_USER=labdb_lesson
LABDB_STACK_DB_PASSWORD=replace-with-a-local-lesson-password
LABDB_STACK_DB_PORT=5433

# Optional FLARE AI assistant. Keep disabled unless all provider values are set.
FLARE_AI_ENABLED=0
FLARE_AI_BASE_URL=http://host.docker.internal:1234/v1
FLARE_AI_API_KEY=replace-with-the-provider-key
FLARE_AI_MODEL=replace-with-the-model-identifier
FLARE_AI_GROUP_NAME=FLARE AI users
FLARE_AI_ASSISTANT_NAME=Marcott-E
